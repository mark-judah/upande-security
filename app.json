{
  "expo": {
    "name": "Upande Security",
    "slug": "upande-security",
    "version": "1.2.13",
    "orientation": "portrait",
    "icon": "./assets/images/upande_logo.png",
    "scheme": "upandesecurity",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.upande.security",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "com.upande.security",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/upande_logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CALL_PHONE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "versionCode": 5213
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/upande_logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/upande_logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Upande Security to scan vehicle work tickets and ID cards."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Upande Security tracks your location during patrols so the route can be logged and reviewed by your supervisor.",
          "locationWhenInUsePermission": "Upande Security needs your location to log patrol routes.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#EF4444"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "@preeternal/react-native-cookie-manager",
      [
        "rn-mrz-scanner",
        {
          "cameraPermissionText": "Allow Upande Security to scan the ID card's MRZ."
        }
      ],
      "@upande/mobile-kit",
      "expo-localization",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": "1.2",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "375a13da-630b-4a49-96e2-0c89c3c9f3d1"
      },
      "otaBaseUrl": "https://mark-judah.github.io/upande-security/ota",
      "mobileKit": {
        "sites": {
          "production": "https://kaitet-group.upande.com",
          "development": "http://10.78.203.154:8002"
        }
      },
      "runtimeSdk": 54
    },
    "owner": "ngetich1",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://kaitet-group.upande.com/api/method/upande_mobile.api.ota.manifest?app=Upande%20Security"
    }
  }
}
