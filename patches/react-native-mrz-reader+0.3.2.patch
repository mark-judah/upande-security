+ * sub-county/division text above the MRZ). That made detection LESS
+ * reliable, not more: sparse-text mode has to find the three MRZ lines
+ * among everything else on the card, and anything it recognizes from that
+ * other content breaks the contiguous 90-character match the TD1 filter
+ * needs once whitespace is stripped (see OcrUtil.filterScannedText).
+ *
+ * The right anchor was never the screen, it's the document: a TD1 card's
+ * machine-readable zone is always printed along the bottom edge (ICAO
+ * 9303), regardless of where in the camera frame the user happens to be
+ * holding the card. Cropping to a generous bottom band keeps that
+ * tolerance - no pixel-perfect alignment required - while cutting out
+ * most of the non-MRZ content that was interfering with the sparse-text
+ * search.
+ */
+fun Bitmap.bottomBand(fraction: Float): Bitmap {
+  val bandHeight = (this.height * fraction).toInt().coerceIn(1, this.height)
+  val yStart = this.height - bandHeight
+  return Bitmap.createBitmap(this, 0, yStart, this.width, bandHeight)
