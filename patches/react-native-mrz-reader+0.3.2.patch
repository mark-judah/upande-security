+
+/**
+ * Patched (upande-security): scale down to at most [maxDimension] on the
+ * longer side, never up.
+ *
+ * Added together with dropping the center-square crop (see
+ * MrzReaderAnalyzer) and switching Tesseract to sparse-text mode (see
+ * MrzUtil) - both of those make each OCR pass see more of the frame, which
+ * on its own would make every pass slower. Every stage downstream
+ * (Leptonica contrast/unsharp/threshold/skew in OcrUtil.preProcessBitmap,
+ * then Tesseract's own layout search) costs roughly in proportion to pixel
+ * count, and a modern rear camera hands back frames far higher-resolution
+ * than an MRZ actually needs - the characters are large, bold, fixed-pitch
+ * print, not fine detail. 1280px keeps them comfortably legible while
+ * cutting the pixel count (and so the time) a full-sensor frame would cost
+ * by several times over.
+ */
+fun Bitmap.scaleDownToMax(maxDimension: Int): Bitmap {
+  val longest = max(this.width, this.height)
+  if (longest <= maxDimension) return this
+  val scale = maxDimension.toFloat() / longest.toFloat()
+  val newWidth = (this.width * scale).toInt().coerceAtLeast(1)
+  val newHeight = (this.height * scale).toInt().coerceAtLeast(1)
+  return Bitmap.createScaledBitmap(this, newWidth, newHeight, true)
+}
